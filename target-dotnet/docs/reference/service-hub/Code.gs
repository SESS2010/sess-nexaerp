function em_(v){return String(v==null?'':v).trim().toLowerCase();}
function fmtDate_(d){let t=Utilities.formatDate(d,CFG.TZ,'HH:mm');return Utilities.formatDate(d,CFG.TZ,t==='00:00'?'yyyy-MM-dd':'yyyy-MM-dd HH:mm');}
