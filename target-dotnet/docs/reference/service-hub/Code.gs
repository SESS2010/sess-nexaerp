/* ================= V2.6 : Year-end archive (Drive) and safe removal ================= */
function fyRange_(fy){const m=String(fy||'').match(/^(\d{4})-(\d{2})$/);if(!m)throw Error('Financial year must look like 2026-27');const y=Number(m[1]);return [new Date(y,3,1),new Date(y+1,3,1)];}
const ARCH_SHEETS=['Complaints','Assignments','Morning_Reports','Evening_Reports','Expenses','Attachments','Status_History','Feedback','Revenue_Ledger','Revenue_Attribution','Daily_Tasks','Projects','Registrations','Audit_Log'];
const ARCH_MASTERS=['Customers','Machines','Employees','Roles','Options','Companies','Settings'];
/** Which rows of each ledger belong to the year and can be archived. Open complaints/tasks stay with their full history. */
function archivePlan_(fy){const [a,b]=fyRange_(fy),inFY=d=>{if(!d)return false;const x=new Date(d);return !isNaN(x)&&x>=a&&x<b;},arch=new Set(),keep=new Set();
 objects_('Complaints').forEach(c=>{const f=c.FY?String(c.FY)==fy:inFY(c.Created_At);if(!f)return;(CLOSED_SET.includes(String(c.Status).toUpperCase())?arch:keep).add(String(c.Complaint_ID));});
 const byC=(r,dcol)=>r.Complaint_ID?arch.has(String(r.Complaint_ID)):inFY(r[dcol]),revIds=new Set();
 const rules={Complaints:r=>arch.has(String(r.Complaint_ID)),Assignments:r=>arch.has(String(r.Complaint_ID)),Morning_Reports:r=>byC(r,'Report_Date'),Evening_Reports:r=>byC(r,'Report_Date'),Expenses:r=>byC(r,'Expense_Date'),Attachments:r=>arch.has(String(r.Complaint_ID)),Status_History:r=>arch.has(String(r.Complaint_ID)),Feedback:r=>arch.has(String(r.Complaint_ID)),
  Revenue_Ledger:r=>{const ok=byC(r,'Document_Date');if(ok)revIds.add(String(r.Revenue_ID));return ok;},Revenue_Attribution:r=>revIds.has(String(r.Revenue_ID)),
  Daily_Tasks:r=>inFY(r.Plan_Date)&&(!r.Complaint_ID||arch.has(String(r.Complaint_ID))),Projects:r=>!truth_(r.Active)&&inFY(r.Closed_At||r.Last_Updated),Registrations:r=>inFY(r.Submitted_At)&&String(r.Status).toUpperCase()!='PENDING',Audit_Log:r=>inFY(r.At)};
 return {fy:fy,from:a,to:b,archivedComplaints:arch.size,openKept:keep.size,rules:rules};}
function archiveInfo(){const u=me_();if(!TOP.includes(u.role))throw Error('Year-end archive is for TD / MD only');const now=new Date(),cur=fy_(now),fys={};objects_('Complaints').forEach(c=>{let f=c.FY||(c.Created_At?fy_(new Date(c.Created_At)):'');if(!/^\d{4}-\d{2}$/.test(String(f)))return;const o=fys[f]||(fys[f]={fy:String(f),total:0,closed:0,open:0});o.total++;CLOSED_SET.includes(String(c.Status).toUpperCase())?o.closed++:o.open++;});
 return out_({currentFy:cur,folderSet:!!getSetting_('ARCHIVE_FOLDER_ID'),years:Object.values(fys).sort((x,y)=>x.fy.localeCompare(y.fy)).map(o=>Object.assign(o,{over:fyRange_(o.fy)[1]<=now})),archives:objects_('Archive_Log').sort((x,y)=>new Date(y.Created_At)-new Date(x.Created_At)).map(r=>({id:r.Archive_ID,fy:r.FY,url:r.Spreadsheet_URL,xlsx:r.XLSX_URL,rows:r.Rows,by:r.Created_By,at:r.Created_At,details:r.Details,removedAt:r.Removed_At,removedBy:r.Removed_By,removedRows:r.Removed_Rows,backup:r.Backup_Name}))});}
function archivePreview(fy){const u=me_();if(!TOP.includes(u.role))throw Error('Year-end archive is for TD / MD only');const P=archivePlan_(fy),out=[];ARCH_SHEETS.forEach(n=>{if(!ss_().getSheetByName(n))return;const rows=objects_(n),m=rows.filter(P.rules[n]).length;out.push({sheet:n,archive:m,stay:rows.length-m});});return out_({fy:fy,from:dateKey_(P.from),to:dateKey_(new Date(P.to.getTime()-864e5)),yearOver:P.to<=new Date(),archivedComplaints:P.archivedComplaints,openKept:P.openKept,sheets:out});}
/** Step 1: copy the year's data to a new Google Sheet + Excel file in Drive (nothing is removed). */
function createArchive(fy){const u=me_();if(!TOP.includes(u.role))throw Error('Year-end archive is for TD / MD only');const P=archivePlan_(fy),folderId=getSetting_('ARCHIVE_FOLDER_ID')||getSetting_('BACKUP_FOLDER_ID'),folder=folderId?DriveApp.getFolderById(folderId):DriveApp.getRootFolder(),stamp=Utilities.formatDate(new Date(),CFG.TZ,'yyyy-MM-dd HHmm'),name='SESS Service Hub ARCHIVE FY '+fy+' ('+stamp+')';
 const out=SpreadsheetApp.create(name),counts={};let total=0;const first=out.getSheets()[0];first.setName('Summary');
 ARCH_SHEETS.concat(ARCH_MASTERS).forEach(n=>{const src=ss_().getSheetByName(n);if(!src)return;const v=values_(n);if(!v.length)return;const h=v[0],isM=ARCH_MASTERS.includes(n),keep=isM?v.slice(1):v.slice(1).filter(r=>{let o={};h.forEach((x,j)=>o[x]=r[j]);return P.rules[n](o);});const t=out.insertSheet(isM?'Master_'+n:n);t.getRange(1,1,1,h.length).setValues([h]);if(keep.length)t.getRange(2,1,keep.length,h.length).setValues(keep);if(!isM){counts[n]=keep.length;total+=keep.length;}});
 const sum=[['SESS Service Hub – Year-end archive',''],['Financial year',fy],['Period',dateKey_(P.from)+' to '+dateKey_(new Date(P.to.getTime()-864e5))],['Created',stamp+' by '+u.email],['Closed complaints / tasks archived',P.archivedComplaints],['Open complaints kept in the app',P.openKept],['',''],['Sheet','Rows archived']].concat(Object.keys(counts).map(k=>[k,counts[k]])).concat([['Master_* sheets','Reference copy of masters on this date (not removed from the app)']]);first.getRange(1,1,sum.length,2).setValues(sum);
 SpreadsheetApp.flush&&SpreadsheetApp.flush();
 // verify every sheet before reporting success
 const bad=[];Object.keys(counts).forEach(k=>{const t=out.getSheetByName(k),n=t?Math.max(0,t.getLastRow()-1):-1;if(n!=counts[k])bad.push(k+' '+n+'/'+counts[k]);});if(bad.length)throw Error('Archive check failed: '+bad.join(', '));
 try{DriveApp.getFileById(out.getId()).moveTo(folder);}catch(e){}
 let xlsxUrl='';try{const blob=UrlFetchApp.fetch('https://docs.google.com/spreadsheets/d/'+out.getId()+'/export?format=xlsx',{headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()}}).getBlob().setName(name+'.xlsx');xlsxUrl=folder.createFile(blob).getUrl();}catch(e){xlsxUrl='';console.warn('xlsx export: '+e.message);}
 const id='ARC-'+Utilities.getUuid().slice(0,8).toUpperCase();append_('Archive_Log',{Archive_ID:id,FY:fy,Spreadsheet_URL:out.getUrl(),XLSX_URL:xlsxUrl,Rows:total,Created_By:u.email,Created_At:new Date(),Locked:false,Spreadsheet_ID:out.getId(),Details:JSON.stringify(counts)});audit_('Archive',id,'CREATE',null,{fy:fy,rows:total,counts:counts},'Year-end archive');
 return out_({archiveId:id,url:out.getUrl(),xlsx:xlsxUrl,rows:total,counts:counts,openKept:P.openKept});}
/** Step 2 (TD/MD, finished years only): remove from the app ONLY rows that are proven to be in the archive. Full safety copy first. */
function removeArchived(archiveId,confirmText){const u=me_();if(!TOP.includes(u.role))throw Error('Only TD / MD can remove archived data');const a=find_('Archive_Log','Archive_ID',archiveId);if(!a)throw Error('Archive not found');const fy=String(a.FY);if(String(confirmText||'').trim().toUpperCase()!=='DELETE '+fy)throw Error('Type exactly: DELETE '+fy);if(a.Removed_At)throw Error('Already removed on '+dateKey_(a.Removed_At));if(fyRange_(fy)[1]>new Date())throw Error('Financial year '+fy+' is not over yet – you can archive (copy) it, but removal is allowed only after 31 March');if(!a.Spreadsheet_ID)throw Error('Archive file id missing – create a new archive');
 let arc;try{arc=SpreadsheetApp.openById(a.Spreadsheet_ID);}catch(e){throw Error('Archive file cannot be opened (deleted or moved to trash?) – create a new archive first');}
 const P=archivePlan_(fy),stamp=Utilities.formatDate(new Date(),CFG.TZ,'yyyy-MM-dd HHmm'),bname='SESS Service Hub BACKUP before removing FY '+fy+' '+stamp,fid=getSetting_('BACKUP_FOLDER_ID')||getSetting_('ARCHIVE_FOLDER_ID');DriveApp.getFileById(ss_().getId()).makeCopy(bname,fid?DriveApp.getFolderById(fid):DriveApp.getRootFolder());
 const removed={};let total=0;lockOn_();try{ARCH_SHEETS.forEach(n=>{const src=ss_().getSheetByName(n),t=arc.getSheetByName(n);if(!src||!t||t.getLastRow()<2)return;const ids=new Set(t.getRange(2,1,t.getLastRow()-1,1).getValues().map(r=>String(r[0])));memoDrop_(n);const v=values_(n);if(v.length<2)return;const h=v[0],keep=[],gone=[];v.slice(1).forEach(r=>{let o={};h.forEach((x,j)=>o[x]=r[j]);(ids.has(String(r[0]))&&P.rules[n](o)?gone:keep).push(r);});if(!gone.length)return;
   const lr=src.getLastRow();src.getRange(2,1,lr-1,h.length).clearContent();if(keep.length)src.getRange(2,1,keep.length,h.length).setValues(keep.map(r=>r.map(cell_)));memoDrop_(n);removed[n]=gone.length;total+=gone.length;});}finally{lockOff_();}
 updateById_('Archive_Log','Archive_ID',archiveId,{Removed_At:new Date(),Removed_By:u.email,Removed_Rows:JSON.stringify(removed),Backup_Name:bname,Locked:true});audit_('Archive',archiveId,'REMOVE_FROM_APP',null,{fy:fy,removed:removed,backup:bname},'Year-end removal after archive');flush_();CacheService.getScriptCache().remove('MASTER_V19');return out_({removed:removed,total:total,backup:bname});}
