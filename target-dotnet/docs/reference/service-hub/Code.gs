 if(why=='UNKNOWN')throw Error(reg?'Your registration is waiting for admin approval. You can login after approval.':near?'Admin saved your email as '+em_(near.Email)+' – ask HR/Admin to correct it in Employees, or login with your Login ID '+near.Login_ID+'.':'No login found for "'+loginId.toLowerCase()+'". '+(typo?'Did you mean '+typo+'? ':'')+'Check spelling, use your Login ID, or register as New employee.');
