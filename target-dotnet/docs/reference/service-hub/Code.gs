 c.remove(fk);const token=Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'');c.put('SES_'+token,em_(u.Email),21600);updateById_('Employees','Employee_ID',u.Employee_ID,{Last_Login:new Date()});CUR_TOKEN=token;CUR_FN='bootstrap';try{audit_('Login',u.Employee_ID,'LOGIN',null,null,'PIN login');return {token:token,boot:bootstrap(),mustChangePin:truth_(u.Pin_Reset)};}finally{CUR_TOKEN='';CUR_FN='';}}
