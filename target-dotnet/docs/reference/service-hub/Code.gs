function memoDrop_(n){if(n){delete VAL_MEMO[n];if(HOT_SHEETS.includes(n))try{CacheService.getScriptCache().remove('SV_'+n);}catch(e){}}else{VAL_MEMO={};try{CacheService.getScriptCache().removeAll(HOT_SHEETS.map(x=>'SV_'+x));}catch(e){}}if(!n||n=='Roles')ROLE_MEMO=null;}
function fresh_(){VAL_MEMO={};ROLE_MEMO=null;}
function objects_(n){let v=values_(n);if(v.length<2)return[];let h=v.shift();return v.filter(r=>r.some(x=>x!==''&&x!=null)).map(r=>Object.fromEntries(h.map((x,i)=>[x,r[i]])));}
function append_(n,o){lockOn_();try{let s=sh_(n),h=s.getRange(1,1,1,s.getLastColumn()).getValues()[0];s.appendRow(h.map(k=>cell_(o[k]===undefined?'':o[k])));memoDrop_(n);}finally{lockOff_();}}
function find_(n,k,id){return objects_(n).find(x=>String(x[k])==String(id));}
function active_(n){return objects_(n).filter(x=>truth_(x.Active));} function truth_(v){return v===true||String(v).toUpperCase()=='TRUE'||v==1;}
/** One lock per request (re-entrant by depth) so two people saving at the same moment never overwrite each other. */
function lockOn_(){if(LOCK_DEPTH++===0){LOCK_OBJ=LockService.getScriptLock();LOCK_OBJ.waitLock(30000);}}
function lockOff_(){if(LOCK_DEPTH>0&&--LOCK_DEPTH===0&&LOCK_OBJ){LOCK_OBJ.releaseLock();LOCK_OBJ=null;}}
/** Update one record: row located and re-read INSIDE the lock (fresh from the sheet), only then written. */
function updateById_(n,k,id,c){lockOn_();try{const s=sh_(n),lr=s.getLastRow(),lc=s.getLastColumn(),h=s.getRange(1,1,1,lc).getValues()[0],ki=h.indexOf(k);if(ki<0)throw Error('Column '+k+' missing in '+n);const ids=lr>1?s.getRange(2,ki+1,lr-1,1).getValues():[];let r=-1;for(let i=0;i<ids.length;i++){if(String(ids[i][0])==String(id)){r=i+2;break;}}if(r<0)throw Error('Record not found');const row=s.getRange(r,1,1,lc).getValues()[0],before=Object.fromEntries(h.map((x,i)=>[x,row[i]]));let lo=lc,hi=-1;Object.keys(c).forEach(x=>{let i=h.indexOf(x);if(i>=0){row[i]=c[x];lo=Math.min(lo,i);hi=Math.max(hi,i);}});if(hi>=0)s.getRange(r,lo+1,1,hi-lo+1).setValues([row.slice(lo,hi+1).map(cell_)]);memoDrop_(n);return before;}finally{lockOff_();}}
