  if(x.Complaint_ID){const c=find_('Complaints','Complaint_ID',x.Complaint_ID),as=objects_('Assignments').filter(a=>String(a.Complaint_ID)==String(x.Complaint_ID)&&!DONE_ASSIGN.includes(String(a.Status).toUpperCase()));if(c&&!as.some(a=>em_(a.Engineer_Email)==newEmail))append_('Assignments',{Assignment_ID:Utilities.getUuid(),Complaint_ID:c.Complaint_ID,Ticket_No:c.Ticket_No,Engineer_Email:newEmail,Engineer_Name:ne.Name,Assignment_Role:'LEAD',Assigned_By:u.email,Assigned_At:now,Visit_Date:dateKey_(x.Plan_Date),Instructions:x.Task,Materials:x.Materials||'',Response:'PENDING',Response_At:'',Response_Remark:'Reassigned from '+x.Employee_Name+': '+reason,Status:'ASSIGNED',Work_Stream:streamOf_(c)});
   const since=dateKey_(x.Plan_Date),stillOld=dailyRows_().some(t=>em_(t.Employee_Email)==old&&String(t.Complaint_ID)==String(x.Complaint_ID)&&!t.Carried_To&&t.Plan_Date&&dateKey_(t.Plan_Date)>=since&&!['COMPLETED','CANCELLED','CARRIED_FORWARD','PARTIAL','NOT_DONE'].includes(String(t.Status).toUpperCase()));if(!stillOld)as.filter(a=>em_(a.Engineer_Email)==old).forEach(a=>updateById_('Assignments','Assignment_ID',a.Assignment_ID,{Status:'CANCELLED',Response_Remark:(a.Response_Remark?a.Response_Remark+' | ':'')+'Shifted to '+ne.Name+' by '+u.email+': '+reason}));}});
