function getBootstrapData() {
  const user = requireUser_();
  const lists = getLists_();
  return {user:user, lists:lists, companies:getCompanies_(), defaultTerms:getDefaultTerms_(), reminderConfig:getReminderConfig_(), financialYear:getFinancialYear_(new Date()), financialYears:getFinancialYears_(), emailEnabled:getEmailSetting_(), gmailSenders:getGmailSenders_(), dashboard:getDashboard({})};
}

function saveLead(payload) {
  const user = requireUser_();
  if (String(user.role).toLowerCase()==='viewer') throw new Error('Viewer access cannot create offers.');
  const lock = LockService.getDocumentLock();
  lock.waitLock(20000);
  try {
    const clean = validateLead_(payload || {});
    const sh = SpreadsheetApp.getActive().getSheetByName(APP.DATA_SHEET);
    const headers = getHeaders_(sh);
    const row = buildRow_(headers, clean, user.email);
    sh.getRange(sh.getLastRow()+1,1,1,headers.length).setValues([row]);
    const offerId=row[headers.indexOf('Offer ID')];
    saveLineItems_(offerId,clean.lineItems,user.email);
    saveOfferTerms_(offerId,clean.terms,user.email);
    writeAudit_('CREATE',offerId,user.email,'Valid save allocated the number.');
    clearDashboardCache_();
    return {ok:true, offerId:offerId, message:'Lead saved successfully.'};
  } finally { lock.releaseLock(); }
}

function updateLead(offerId, payload) {
  const user = requireUser_();
  if (String(user.role).toLowerCase()==='viewer') throw new Error('Viewer access cannot edit offers.');
  if (!offerId) throw new Error('Offer ID is required.');
  const lock = LockService.getDocumentLock(); lock.waitLock(20000);
  try {
    const sh = SpreadsheetApp.getActive().getSheetByName(APP.DATA_SHEET);
    const values = sh.getDataRange().getValues(); const headers = values[0];
    const idCol = headers.indexOf('Offer ID');
    const i = values.findIndex((r,n)=>n>0 && String(r[idCol]).trim()===String(offerId).trim());
    if (i < 1) throw new Error('Offer ID not found.');
    const existing = Object.fromEntries(headers.map((h,c)=>[h,values[i][c]]));
    const clean = validateLead_(Object.assign(existing,payload||{}));
    const row = buildRow_(headers, clean, user.email, offerId);
    sh.getRange(i+1,1,1,headers.length).setValues([row]); writeAudit_('UPDATE',offerId,user.email,'Offer updated.'); clearDashboardCache_();
    return {ok:true, offerId:offerId, message:'Lead updated successfully.'};
  } finally { lock.releaseLock(); }
}

function searchLeads(query) {
  requireUser_();
  const sh = SpreadsheetApp.getActive().getSheetByName(APP.DATA_SHEET);
  const v = sh.getDataRange().getDisplayValues(); if (v.length < 2) return [];
  const h=v[0], q=String(query||'').trim().toLowerCase();
  const cols=['Offer ID','Customer Name','Product / Scope','Contact Person','Sales Stage'].map(x=>h.indexOf(x));
  return v.slice(1).filter(r=>!q || cols.some(c=>c>=0 && String(r[c]).toLowerCase().includes(q))).slice(-200).reverse().map(r=>Object.fromEntries(h.map((x,i)=>[x,r[i]])));
}

function getCurrentLedger(scope) {
  requireUser_();
  const sh=SpreadsheetApp.getActive().getSheetByName(APP.DATA_SHEET),v=sh.getDataRange().getDisplayValues();
  if(v.length<2)return[];
  const h=v[0],ix=Object.fromEntries(h.map((x,i)=>[x,i])),now=new Date(),choice=String(scope||'CURRENT FY').toUpperCase();
  const days=choice==='LAST 3 MONTHS'?92:choice==='LAST 6 MONTHS'?183:choice==='LAST 12 MONTHS'?365:0;
  let rows=v.slice(1).filter(r=>String(r[ix['Customer Name']]||'').trim());
  if(days){const cutoff=new Date(now.getTime()-days*86400000);rows=rows.filter(r=>{const d=toDate_(r[ix['Offer Date']]);return d&&d>=cutoff;});}
  else rows=rows.filter(r=>String(r[ix['Year']]||'')===getFinancialYear_(now));
  return rows.map((r,n)=>({r:r,n:n,date:toDate_(r[ix['Offer Date']])})).sort((a,b)=>(b.date||0)-(a.date||0)||b.n-a.n).slice(0,500).map(x=>Object.fromEntries(h.map((k,i)=>[k,x.r[i]])));
}

function getDashboard(filters) {
  requireUser_();
  const version=PropertiesService.getDocumentProperties().getProperty('DASH_VERSION')||'1';
  const key='dash_'+version+'_'+Utilities.base64EncodeWebSafe(JSON.stringify(filters||{})).slice(0,80);
  const cached=CacheService.getDocumentCache().get(key); if(cached) return JSON.parse(cached);
  const sh=SpreadsheetApp.getActive().getSheetByName(APP.DATA_SHEET), v=sh.getDataRange().getValues();
  if(v.length<2) return emptyDashboard_();
  const h=v[0], ix=Object.fromEntries(h.map((x,i)=>[x,i]));
  let rows=v.slice(1).filter(r=>String(r[ix['Customer Name']]||'').trim());
  const fy=String((filters||{}).year||'').trim(); if(fy) rows=rows.filter(r=>String(r[ix['Year']])===fy);
  const stage=r=>String(r[ix['Sales Stage']]||'').toUpperCase(), prob=r=>Number(r[ix['Probability %']]||0), val=r=>Number(r[ix['Current Offer Value']]||0);
  const won=r=>['WON','WORK COMPLETED','MATERIAL DELIVERED'].includes(stage(r)), lost=r=>stage(r)==='LOST';
  const funnel=[['All leads',rows.length],['Qualified 30%+',rows.filter(r=>prob(r)>=30).length],['Technical 40%+',rows.filter(r=>prob(r)>=40).length],['Negotiation 80%+',rows.filter(r=>prob(r)>=80).length],['Final 90%+',rows.filter(r=>prob(r)>=90).length],['Won / 100%',rows.filter(r=>won(r)||prob(r)>=100).length]];
  const months=['Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec','Jan','Feb','Mar'];
  const monthly=months.map(m=>{const a=rows.filter(r=>String(r[ix['Offer Month']]||'').slice(0,3).toLowerCase()===m.toLowerCase());return {month:m,leads:a.length,won:a.filter(won).length,lost:a.filter(lost).length,open:a.filter(r=>!won(r)&&!lost(r)).length};});
  const result={total:rows.length,open:rows.filter(r=>!won(r)&&!lost(r)).length,pipeline:rows.reduce((s,r)=>s+val(r),0),weighted:rows.reduce((s,r)=>s+val(r)*prob(r)/100,0),wonValue:rows.filter(won).reduce((s,r)=>s+Number(r[ix['PO Value']]||val(r)),0),winRate:rows.filter(won).length/Math.max(1,rows.filter(won).length+rows.filter(lost).length),funnel:funnel,monthly:monthly,years:yearComparison_(v)};
  CacheService.getDocumentCache().put(key,JSON.stringify(result),APP.CACHE_SECONDS); return result;
}

function importHistoricalCsv(csvText, financialYear) {
  const user=requireUser_(); if(user.role!=='Admin') throw new Error('Admin access is required for history import.');
  const fy=String(financialYear||'').trim(); if(!/^20\d{2}-\d{2}$/.test(fy)) throw new Error('Financial year must be like 2024-25.');
  const parsed=Utilities.parseCsv(String(csvText||'')); if(parsed.length<2) throw new Error('CSV has no data rows.');
  const sourceHeaders=parsed[0].map(x=>String(x).trim()), sh=SpreadsheetApp.getActive().getSheetByName(APP.DATA_SHEET), headers=getHeaders_(sh);
  const required=['Offer ID','Customer Name','Sales Stage']; required.forEach(x=>{if(sourceHeaders.indexOf(x)<0) throw new Error('Missing column: '+x);});
  const offerIdCol=headers.indexOf('Offer ID')+1;
  const existing=new Set(sh.getLastRow()>1?sh.getRange(2,offerIdCol,sh.getLastRow()-1,1).getDisplayValues().flat().filter(String):[]);
  const out=[]; parsed.slice(1).forEach(src=>{const id=String(src[sourceHeaders.indexOf('Offer ID')]||'').trim(); if(!id||existing.has(id))return; const obj={}; sourceHeaders.forEach((x,i)=>obj[x]=src[i]); obj['Year']=fy; out.push(buildRow_(headers,obj,user.email,id)); existing.add(id);});
  if(out.length) sh.getRange(sh.getLastRow()+1,1,out.length,headers.length).setValues(out); clearDashboardCache_();
  return {ok:true, imported:out.length, skipped:parsed.length-1-out.length};
}

function buildRow_(headers,p,userEmail,keepId) {
  const now=new Date(), offerDate=toDate_(p['Offer Date'])||now, stage=String(p['Sales Stage']||'NEW ENQUIRY').toUpperCase(), probability=Number(p['Probability %']||stageProbability_(stage));
  const current=Number(p['Current Offer Value']||p['Revised Offer Value']||p['Original Offer Value']||0), original=Number(p['Original Offer Value']||current), next=toDate_(p['Next Follow-up']);
  const fy=String(p['Year']||getFinancialYear_(offerDate));
  const offerId=keepId||p['Offer ID']||nextOfferId_(fy),baseId=p['Base Offer ID']||offerId;
  const derived={'Record UUID':p['Record UUID']||Utilities.getUuid(),'Offer ID':offerId,'Offer Date':offerDate,'Enquiry Date':toDate_(p['Enquiry Date'])||offerDate,'Offer Age (Days)':Math.max(0,Math.floor((now-offerDate)/86400000)),'Sales Stage':stage,'Probability %':probability,'Current Offer Value':current,'Weighted Pipeline':current*probability/100,'Discount Value':Math.max(0,original-current),'Year':fy,'FY Quarter':getQuarter_(offerDate),'Offer Month':Utilities.formatDate(offerDate,Session.getScriptTimeZone(),'MMM'),'Created At':p['Created At']||now,'Created By':p['Created By']||userEmail,'Last Updated':now,'Updated By':userEmail,'ERP Sync Status':p['ERP Sync Status']||'NOT SYNCED','Email Automation':p['Email Automation']||'DISABLED','Reminder Scope':p['Reminder Scope']||'CURRENT FY','Company':p['Company']||'PVT','Base Offer ID':baseId,'Revision No':Number(p['Revision No']||0),'Revision Status':p['Revision Status']||'CURRENT','Parent Revision ID':p['Parent Revision ID']||'','Secure Response Token':p['Secure Response Token']||Utilities.getUuid().replace(/-/g,''),'Follow-up Alert':APP.CLOSED.includes(stage)?'CLOSED':followupAlert_(next),'Days Overdue':next?Math.max(0,Math.floor((now-next)/86400000)):0};
  return headers.map(h=>Object.prototype.hasOwnProperty.call(derived,h)?derived[h]:(p[h]??''));
}

function validateLead_(p){ const items=parseLineItems_(p.lineItems); if(items.length){p['Product / Scope']=items.map(x=>x.item+(x.description?' — '+x.description:'')).join('; ');p['Qty']=items.reduce((s,x)=>s+Number(x.qty||0),0);p['Current Offer Value']=items.reduce((s,x)=>s+Number(x.qty||0)*Number(x.unitPrice||0),0);p.lineItems=items;}p.terms=parseTerms_(p.terms&&parseTerms_(p.terms).length?p.terms:getDefaultTerms_()); ['Customer Name','Offer Date','Requested By','Prepared By','Sales Owner','Department','Business Type','Product / Scope','Qty','Current Offer Value','Sales Stage'].forEach(x=>{if(!String(p[x]||'').trim())throw new Error(x+' is mandatory. Offer number has not been allocated.');}); if(Number(p['Qty'])<=0)throw new Error('Qty must be greater than zero. Offer number has not been allocated.'); if(Number(p['Current Offer Value'])<=0)throw new Error('Offer value must be greater than zero. Offer number has not been allocated.'); if(!String(p['Email']||p['Phone']||'').trim())throw new Error('Enter customer email or phone. Offer number has not been allocated.'); return p; }
function getHeaders_(sh){return sh.getRange(1,1,1,sh.getLastColumn()).getDisplayValues()[0].map(String);}
function toDate_(v){if(v instanceof Date&&!isNaN(v))return v;if(!v)return null;const d=new Date(v);return isNaN(d)?null:d;}
function getFinancialYear_(d){const y=d.getFullYear(), m=d.getMonth()+1; return m>=4?y+'-'+String(y+1).slice(-2):(y-1)+'-'+String(y).slice(-2);}
function getQuarter_(d){const m=d.getMonth()+1;return m<=3?'Q4':m<=6?'Q1':m<=9?'Q2':'Q3';}
function followupAlert_(d){if(!d)return'NOT SCHEDULED';const n=new Date(),days=Math.ceil((d-n)/86400000);return days<0?'OVERDUE':days===0?'DUE TODAY':days<=3?'DUE SOON':'SCHEDULED';}
function stageProbability_(s){const map={'NEW ENQUIRY':10,'REQUIREMENT CLARIFICATION':20,'OFFER SUBMITTED':30,'TECHNICAL EVALUATION UNDER PROCESS':40,'IN PROGRESS':50,'NEGOTIATION':80,'FINAL':90,'WORK COMPLETED':95,'MATERIAL DELIVERED':95,'WON':100,'LOST':0,'ON HOLD':10,'CLOSED':0,'CANCELLED':0};return map[s]??10;}
function nextOfferId_(fy){const p=PropertiesService.getDocumentProperties(),key='SEQ_'+fy,n=Number(p.getProperty(key)||0)+1;p.setProperty(key,String(n));return formatOfferId_(n,fy);}
function formatOfferId_(sequence,fy){return'SESS/OFR/'+String(Number(sequence)||0).padStart(4,'0')+'/'+fy;}
function formatRevisionId_(baseId,revision,fy){const sequence=extractOfferSequence_(baseId);if(!sequence)throw new Error('Cannot identify the running number from parent offer '+baseId+'.');return'SESS/OFR/'+String(sequence).padStart(4,'0')+'/R'+String(revision).padStart(2,'0')+'/'+fy;}
function extractOfferSequence_(id){const s=String(id||'').trim();let m=s.match(/^SESS\/OFR\/(\d+)(?:\/R\d+)?\/20\d{2}-\d{2}$/i);if(m)return Number(m[1]);m=s.match(/^SESS-OFR-\d{2}-(\d+)$/i);if(m)return Number(m[1]);m=s.match(/^(\d+)(?:\.0+)?$/);if(m)return Number(m[1]);m=s.match(/(?:^|\D)(\d{1,6})(?:\D|$)/);return m?Number(m[1]):0;}
function resetIdCounters_(){const sh=SpreadsheetApp.getActive().getSheetByName(APP.DATA_SHEET),v=sh.getDataRange().getDisplayValues(),h=v[0],ii=h.indexOf('Offer ID'),yi=h.indexOf('Year'),max={};v.slice(1).forEach(r=>{const fy=String(r[yi]||'').trim(),n=extractOfferSequence_(r[ii]);if(fy&&n)max[fy]=Math.max(max[fy]||0,n);});const p=PropertiesService.getDocumentProperties();Object.keys(max).forEach(k=>p.setProperty('SEQ_'+k,String(max[k])));}
function getLists_(){const sh=SpreadsheetApp.getActive().getSheetByName(APP.SETTINGS_SHEET),v=sh?sh.getDataRange().getDisplayValues():[],base={stages:v.slice(1,13).map(r=>r[0]).filter(String),priorities:['Critical','High','Medium','Low'],owners:[...new Set(v.slice(6).map(r=>r[3]).filter(String))],zones:v.slice(1).map(r=>r[5]).filter(String),businessTypes:['Sales','Service','Spares','Sales & Service','AMC','Rental','Testing','Design','Other'],departments:['Sales','Service','Spares','Design','Accounts','Management','Other'],enquiryModes:['Mail','Phone','On-site Visit','Expo','Tender','Referral','Website','Existing Customer','Other']};const c=ensureSheet_('Custom Options',['List Name','Option Value','Active','Created At','Created By']).getDataRange().getDisplayValues();c.slice(1).forEach(r=>{const k=String(r[0]||''),val=String(r[1]||'').trim(),active=String(r[2]||'').toLowerCase()!=='false';if(base[k]&&val&&active&&!base[k].includes(val))base[k].push(val);});if(!base.stages.includes('CLOSED'))base.stages.push('CLOSED');return base;}
function applyValidations_(){const sh=SpreadsheetApp.getActive().getSheetByName(APP.DATA_SHEET),h=getHeaders_(sh),lists=getLists_(),last=5000;[['Sales Stage',lists.stages],['Priority',lists.priorities],['Zone',lists.zones],['Business Type',lists.businessTypes]].forEach(([name,vals])=>{const c=h.indexOf(name)+1;if(c>0&&vals.length)sh.getRange(2,c,last-1,1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(vals,true).setAllowInvalid(false).build());});}
function requireUser_(){const email=Session.getActiveUser().getEmail()||Session.getEffectiveUser().getEmail();const sh=SpreadsheetApp.getActive().getSheetByName(APP.USERS_SHEET);if(!sh)return{email:email,role:'Admin'};const v=sh.getDataRange().getDisplayValues(), h=v[0].map(String), ei=h.indexOf('Email'),ri=h.indexOf('Role'),ai=h.indexOf('Active');const r=v.slice(1).find(x=>String(x[ei]).toLowerCase()===String(email).toLowerCase()&&String(x[ai]).toLowerCase()!=='false');if(!r)throw new Error('Your Google account is not enabled. Admin must fill your email in Users sheet.');return{email:email,role:r[ri]||'Sales'};}
