function addListOption(listName,value){const user=requireUser_();if(String(user.role).toLowerCase()==='viewer')throw new Error('Viewer cannot add options.');const allowed=['zones','businessTypes','owners','departments','enquiryModes'],v=String(value||'').trim();if(!allowed.includes(listName)||!v)throw new Error('Valid list and option are required.');const sh=ensureSheet_('Custom Options',['List Name','Option Value','Active','Created At','Created By']),rows=sh.getDataRange().getDisplayValues();if(rows.slice(1).some(r=>r[0]===listName&&r[1].toLowerCase()===v.toLowerCase()))return getLists_();sh.appendRow([listName,v,true,new Date(),user.email]);writeAudit_('ADD_OPTION','',user.email,listName+': '+v);return getLists_();}
