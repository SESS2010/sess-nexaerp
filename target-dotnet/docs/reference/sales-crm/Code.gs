function processCustomerReplies(){if(!getEmailSetting_())return{processed:0,changed:0,reason:'Email disabled'};const comm=ensureSheet_('Communications',['Timestamp','Offer ID','Direction','Channel','From','To','CC','Subject','Message','Status','User','Gmail Thread ID']),cv=comm.getDataRange().getDisplayValues(),seen=new Set(cv.slice(1).filter(r=>r[2]==='INBOUND').map(r=>r[11])),own=new Set(getGmailSenders_().map(x=>x.toLowerCase()));let processed=0,changed=0;const threads=[...new Map(cv.slice(1).filter(r=>r[2]==='OUTBOUND'&&r[11]&&!String(r[11]).includes('|')).map(r=>[r[11],r[1]])).entries()];threads.forEach(([threadId,offerId])=>{try{const t=GmailApp.getThreadById(threadId);if(!t)return;t.getMessages().forEach(m=>{const from=extractEmail_(m.getFrom()),messageKey=threadId+'|'+m.getId();if(!from||own.has(from)||seen.has(messageKey))return;const body=stripQuotedReply_(m.getPlainBody()||'').slice(0,5000),stage=detectStageFromEmail_(body);logCommunication_(offerId,'INBOUND','EMAIL',m.getFrom(),m.getTo(),' ',m.getSubject(),body,stage?'STAGE AUTO-UPDATED':'MANUAL REVIEW REQUIRED','SYSTEM',messageKey);processed++;if(stage){updateStageFromEmail_(offerId,stage,body);changed++;}});}catch(e){logCommunication_(offerId,'SYSTEM','EMAIL','','','','Reply processing error',String(e.message||e),'FAILED','SYSTEM',threadId+'|ERROR');}});return{processed:processed,changed:changed};}
