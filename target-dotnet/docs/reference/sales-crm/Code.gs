function setCompanyLogoFileId(fileId){const u=requireUser_();if(String(u.role).toLowerCase()!=='admin')throw new Error('Admin required.');DriveApp.getFileById(String(fileId||'')).getName();PropertiesService.getDocumentProperties().setProperty('COMPANY_LOGO_FILE_ID',String(fileId));return{ok:true};}
function getLogoData_(){const id=PropertiesService.getDocumentProperties().getProperty('COMPANY_LOGO_FILE_ID');if(!id)return'';try{const b=DriveApp.getFileById(id).getBlob();return'data:'+b.getContentType()+';base64,'+Utilities.base64Encode(b.getBytes());}catch(e){return'';}}
function getQuotationHtml(offerId){requireUser_();const d=getLeadDetail(offerId),l=d.lead,company=getCompanies_().find(x=>x['Company Code']===(l.Company||'PVT'))||getCompanies_()[0],items=d.lineItems.length?d.lineItems:[{'Item / Product':l['Product / Scope'],'Description / Scope':'',Qty:l.Qty,Unit:'Nos','Unit Price':l['Current Offer Value'],'Line Amount':l['Current Offer Value']}],basic=items.reduce((s,x)=>s+numeric_(x['Line Amount']||numeric_(x.Qty)*numeric_(x['Unit Price'])),0),gst=basic*.18,total=basic+gst,terms=getOfferTerms_(offerId),logo=getLogoData_(),rows=items.map((x,i)=>'<tr><td>'+(i+1)+'</td><td><b>'+htmlEscape_(x['Item / Product'])+'</b><br>'+htmlEscape_(x['Description / Scope'])+'</td><td>'+htmlEscape_(x.Qty)+'</td><td>'+htmlEscape_(x.Unit)+'</td><td class="num">'+formatInr_(x['Unit Price'])+'</td><td class="num">'+formatInr_(x['Line Amount'])+'</td></tr>').join('');return'<!doctype html><html><head><meta charset="utf-8"><title>'+htmlEscape_(offerId)+'</title><style>@page{size:A4;margin:14mm}body{font:12px Arial;color:#1f2937}.head{display:flex;align-items:center;border-bottom:3px solid #17365d;padding-bottom:8px}.logo{width:150px;max-height:60px;object-fit:contain}.co{flex:1;text-align:right}.title{text-align:center;font-size:18px;font-weight:bold;margin:14px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.box{border:1px solid #9aa;padding:9px}table{width:100%;border-collapse:collapse;margin-top:12px}th,td{border:1px solid #777;padding:7px;vertical-align:top}th{background:#17365d;color:#fff}.num{text-align:right}.total{width:45%;margin-left:auto}.terms li{margin:5px 0}.foot{margin-top:25px;display:flex;justify-content:space-between}@media print{button{display:none}}</style></head><body><div class="head">'+(logo?'<img class="logo" src="'+logo+'">':'<h1>SESS</h1>')+'<div class="co"><b>'+htmlEscape_(company['Company Name'])+'</b><br>'+htmlEscape_(company.Address)+'<br>GSTIN: '+htmlEscape_(company.GSTIN)+'<br>'+htmlEscape_(company.Email)+' | '+htmlEscape_(company.Phone)+'</div></div><div class="title">TECHNO COMMERCIAL OFFER</div><div class="grid"><div class="box"><b>To</b><br>'+htmlEscape_(l['Customer Name'])+'<br>'+htmlEscape_(l['Customer Address'])+'<br>'+htmlEscape_(l['Contact Person'])+'<br>'+htmlEscape_(l.Email)+'</div><div class="box"><b>Offer No:</b> '+htmlEscape_(l['Offer ID'])+'<br><b>Revision:</b> '+htmlEscape_(l['Revision No']||0)+'<br><b>Date:</b> '+htmlEscape_(l['Offer Date'])+'<br><b>Prepared by:</b> '+htmlEscape_(l['Prepared By'])+'</div></div><table><tr><th>Sl</th><th>Description</th><th>Qty</th><th>Unit</th><th>Unit Price</th><th>Amount</th></tr>'+rows+'</table><table class="total"><tr><td>Basic Value</td><td class="num">'+formatInr_(basic)+'</td></tr><tr><td>GST 18%</td><td class="num">'+formatInr_(gst)+'</td></tr><tr><td><b>Grand Total</b></td><td class="num"><b>'+formatInr_(total)+'</b></td></tr></table><h3>Terms and Conditions</h3><ol class="terms">'+terms.map(r=>'<li><b>'+htmlEscape_(r.term)+':</b> '+htmlEscape_(r.condition)+'</li>').join('')+'</ol><div class="foot"><div>For '+htmlEscape_(company['Company Name'])+'<br><br><br>Authorised Signatory</div><div>Customer Acceptance<br><br><br>Signature and Seal</div></div></body></html>';}
function numeric_(v){return Number(String(v==null?'':v).replace(/[^0-9.-]/g,''))||0;}
function formatInr_(v){return'₹'+numeric_(v).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2});}
