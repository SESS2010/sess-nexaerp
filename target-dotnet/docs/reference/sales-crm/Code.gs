function sendOfferEmail(offerId,subject,message,fromEmail){const user=requireUser_();if(!getEmailSetting_())throw new Error('Email is disabled in CRM settings.');const lead=getLeadDetail(offerId),to=lead.lead['Email'],cc=lead.lead['CC Email']||'',allowed=getGmailSenders_(),from=String(fromEmail||allowed[0]||'').toLowerCase();if(!to)throw new Error('Customer email is missing.');if(!allowed.map(x=>x.toLowerCase()).includes(from))throw new Error('Selected sender is not an authorised Gmail account or alias.');let status='SENT',err='',thread='';try{const primary=(Session.getEffectiveUser().getEmail()||'').toLowerCase(),opt={cc:cc,name:'SESS Sales Team'};if(from!==primary)opt.from=from;const draft=GmailApp.createDraft(to,String(subject||('Offer '+offerId)),String(message||''),opt),sent=draft.send();thread=sent.getThread().getId();}catch(e){status='FAILED';err=e.message;}ensureSheet_('Email Log',['Timestamp','Offer ID','Recipient','CC','Subject','Status','Sent By','Error']).appendRow([new Date(),offerId,to,cc,subject,status,from,err]);logCommunication_(offerId,'OUTBOUND','EMAIL',from,to,cc,subject,message,status,user.email,thread);writeAudit_('EMAIL_'+status,offerId,user.email,from+' → '+to);if(err)throw new Error(err);return{ok:true,message:'Email sent from '+from+' and communication recorded.'};}
