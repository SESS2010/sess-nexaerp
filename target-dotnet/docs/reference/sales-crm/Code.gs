  const tc=ensureSheet_('Terms & Conditions',['Sequence','Term','Condition','Active']);
  if(tc.getLastRow()===1)tc.getRange(2,1,8,4).setValues([[1,'Payment','As agreed in the approved commercial offer.',true],[2,'GST','GST extra at the prevailing statutory rate unless stated otherwise.',true],[3,'Delivery','From confirmed order, advance and approved technical inputs.',true],[4,'Validity','30 days from offer date unless stated otherwise.',true],[5,'Warranty','12 months from commissioning or 13 months from dispatch, whichever is earlier.',true],[6,'Installation','Subject to customer site readiness and utilities.',true],[7,'Jurisdiction','Chennai jurisdiction only.',true],[8,'Revision','Specification changes may affect price and delivery.',true]]);
