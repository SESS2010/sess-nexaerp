const POLICY41={EXP_HEADERS:['Expense Type','Employee Grade','People Count','GST Bill Available?','Ticket Type','Attachment URLs','Policy Limit','Policy Status','Policy Exception Reason','Cash Account'],GRADES:{STANDARD:250,SENIOR:300,SUPERIOR:350},NONGST_DAILY_CAP:500,PETTY_MAX:5000,LODGE_SINGLE:800,LODGE_DOUBLE:1500};
function addHeadersV41_(sheetName,headers){const sh=sheet_(sheetName),h=sh.getRange(1,1,1,Math.max(1,sh.getLastColumn())).getDisplayValues()[0];headers.forEach(x=>{if(!h.includes(x)){sh.getRange(1,sh.getLastColumn()+1).setValue(x).setFontWeight('bold').setBackground('#14324d').setFontColor('#ffffff');h.push(x)}})}
function setupExpensePolicyV41_(){addHeadersV41_(S.EXP,POLICY41.EXP_HEADERS);addHeadersV41_(S.EMP,['Expense Grade']);const pr=ensureSheet_('Expense Policy',['Policy','Applies To','Limit ₹','Evidence Required','Action','Active?']);if(pr.getLastRow()<2)pr.getRange(2,1,8,6).setValues([['Food Standard','Food',250,'Bill URL','Exception reason above limit','Yes'],['Food Senior','Food',300,'Bill URL','Exception reason above limit','Yes'],['Food Superior','Food',350,'Bill URL','Exception reason above limit','Yes'],['Lodging Single','Lodging - Single',800,'Hotel bill URL','Exception reason above limit','Yes'],['Lodging Double','Lodging - Double',1500,'Hotel bill URL and 2 people','Exception reason above limit','Yes'],['Bus / Train','Bus / Train Travel',0,'Ticket URL','Ticket mandatory','Yes'],['Non-GST petty cash','Petty Cash Purchase',500,'Bill / cash memo','Block above daily cap','Yes'],['Site petty purchase','Petty Cash Purchase',5000,'GST bill above ₹500','Move ₹5000+ to purchase/PO process','Yes']]);ensureSheet_('Cash Flow Obligations',['Obligation ID','Month','Company','Expense Head','Due Date','Planned Amount','Status','Paid Date','Reference','Attachment URL','Remarks','Entered By','Entered At']);ensureSheet_('Daily Policy Usage',['Usage Key','Date','Employee ID','Expense Type','GST Scope','Total Amount','Entry Count','Updated At']);return'Expense policy, multiple evidence, fast daily policy summary and cash-flow planner controls added.'}
function urlsV41_(f){const raw=[f.receiptUrl||'',f.attachmentUrls||''].join('\n'),a=raw.split(/[\n,]+/).map(x=>x.trim()).filter(Boolean);a.forEach(x=>{if(!/^https:\/\//i.test(x))throw Error('Every bill/ticket attachment must be an HTTPS Google Drive or document URL')});return[...new Set(a)]}
function empGradeV41_(id){const x=objs_(S.EMP).find(e=>String(e['Employee ID'])===String(id)),g=String(x&&x['Expense Grade']||'Standard').trim().toUpperCase();return POLICY41.GRADES[g]?g:'STANDARD'}
function usageKeyV41_(date,id,type,scope){return[date_(date),id,type,scope].join('|')}
function dailyExpenseTotalV41_(date,id,type,noGstOnly){const key=usageKeyV41_(date,id,type,noGstOnly?'NO_GST':'ALL'),sh=sheet_('Daily Policy Usage'),hit=sh.getRange(1,1,Math.max(1,sh.getLastRow()),1).createTextFinder(key).matchEntireCell(true).findNext();return hit?num_(sh.getRange(hit.getRow(),6).getValue()):0}
function updatePolicyUsageV41_(date,id,type,gst,amt){const sh=sheet_('Daily Policy Usage'),scopes=['ALL'].concat(String(gst).toUpperCase()==='YES'?[]:['NO_GST']);scopes.forEach(scope=>{const key=usageKeyV41_(date,id,type,scope),hit=sh.getRange(1,1,Math.max(1,sh.getLastRow()),1).createTextFinder(key).matchEntireCell(true).findNext();if(hit){const r=hit.getRow();sh.getRange(r,6,1,3).setValues([[num_(sh.getRange(r,6).getValue())+amt,num_(sh.getRange(r,7).getValue())+1,new Date()]])}else sh.appendRow([key,new Date(date),id,type,scope,amt,1,new Date()])})}
function policyCheckV41_(f,e,amt){const type=String(f.expenseType||'Other').trim(),grade=empGradeV41_(e.id),urls=urlsV41_(f),reason=String(f.policyReason||'').trim(),gst=String(f.gstBill||f.gstIncluded||'No'),people=Math.max(1,Number(f.peopleCount)||1),ticket=String(f.ticketType||''),date=date_(f.date);let limit=0,status='COMPLIANT',mandatory=false;if(type==='Food'){limit=POLICY41.GRADES[grade];mandatory=true;const total=dailyExpenseTotalV41_(date,e.id,type,false)+amt;if(total>limit){status='EXCEPTION - FOOD LIMIT';if(reason.length<15)throw Error('Daily food limit is ₹'+limit+' for '+grade+'. Enter a detailed exception reason.')}}else if(type==='Lodging - Single'){limit=POLICY41.LODGE_SINGLE;mandatory=true;if(people!==1)throw Error('Single lodging must have People Count = 1');if(amt>limit){status='EXCEPTION - LODGING LIMIT';if(reason.length<15)throw Error('Single lodging limit is ₹800. Enter a detailed exception reason.')}}else if(type==='Lodging - Double'){limit=POLICY41.LODGE_DOUBLE;mandatory=true;if(people!==2)throw Error('Double lodging must have People Count = 2');if(amt>limit){status='EXCEPTION - LODGING LIMIT';if(reason.length<15)throw Error('Double lodging limit is ₹1500. Enter a detailed exception reason.')}}else if(type==='Bus / Train Travel'){mandatory=true;if(!['Bus','Train'].includes(ticket))throw Error('Select Bus or Train ticket type')}else if(type==='Petty Cash Purchase'){mandatory=true;limit=POLICY41.PETTY_MAX;if(amt>=POLICY41.PETTY_MAX)throw Error('₹5000 or above must use the Purchase / PO process, not daily petty cash');if(gst.toUpperCase()!=='YES'){const total=dailyExpenseTotalV41_(date,e.id,type,true)+amt;if(total>POLICY41.NONGST_DAILY_CAP)throw Error('Non-GST petty cash is limited to ₹500 per employee per day');status='NON-GST WITHIN ₹500 DAILY CAP';limit=POLICY41.NONGST_DAILY_CAP}else if(!String(f.invoiceNo||'').trim())throw Error('GST Invoice Number is required for GST site purchase')}if(mandatory&&!urls.length)throw Error('Bill / ticket attachment URL is mandatory for '+type);return{type,grade,urls,reason,gst,people,ticket,limit,status,cashAccount:String(f.cashAccount||'Petty Cash')}}
function saveExpenseV41_(f){return locked_(()=>{const u=user_(),e=employeeFor_(f.employeeId,u),amt=Number(f.amount);if(!(amt>0))throw Error('Amount must be above zero');const p=policyCheckV41_(f,e,amt),b=bootstrap();if(amt>=b.receiptThreshold&&!p.urls.length)throw Error('Receipt URL is required for this amount');const now=new Date(),id=Utilities.formatDate(now,TZ,'yyyyMMdd-HHmmss')+'-EXP-'+Utilities.getUuid().slice(0,8),obj={'Expense ID':id,'Date':new Date(f.date),'Company':f.company,'Employee ID':e.id,'Employee Name':e.name,'Category':f.category,'Subcategory':f.subcategory||'','Vendor / Payee':f.vendor||'','Description':f.description||'','Claimed Amount':amt,'Payment Mode':f.mode||'Cash','Status':'Submitted','Accepted Amount':'','Rejected Amount':0,'GST Included?':p.gst,'GST Amount':Number(f.gstAmount)||0,'Cost Centre':f.costCentre||'','Project / Customer':f.project||'','Invoice No.':f.invoiceNo||'','Invoice Date':f.invoiceDate?new Date(f.invoiceDate):'','Receipt URL':p.urls[0]||'','Approver':'','Approved At':'','Entered By':u.email,'Entered At':now,'Expense Type':p.type,'Employee Grade':p.grade,'People Count':p.people,'GST Bill Available?':p.gst,'Ticket Type':p.ticket,'Attachment URLs':p.urls.join('\n'),'Policy Limit':p.limit,'Policy Status':p.status,'Policy Exception Reason':p.reason,'Cash Account':p.cashAccount};appendObject_(sheet_(S.EXP),obj);updatePolicyUsageV41_(f.date,e.id,p.type,p.gst,amt);audit_('GENERAL EXPENSE',id,'','Submitted',amt,p.status+(p.reason?' | '+p.reason:''),u);return{ok:true,id,policyStatus:p.status,policyLimit:p.limit}})}
function saveObligationV41_(f){return locked_(()=>{const u=requireAccountsAction_(),amt=Number(f.amount);if(!(amt>0))throw Error('Planned amount must be above zero');const month=String(f.month||'');if(!/^\d{4}-\d{2}$/.test(month))throw Error('Valid month is required');const now=new Date(),id=month.replace('-','')+'-CFO-'+Utilities.getUuid().slice(0,8);appendObject_(sheet_('Cash Flow Obligations'),{'Obligation ID':id,'Month':month,'Company':f.company||'','Expense Head':f.head||'','Due Date':f.dueDate?new Date(f.dueDate):'','Planned Amount':amt,'Status':f.status||'Planned','Paid Date':f.paidDate?new Date(f.paidDate):'','Reference':f.reference||'','Attachment URL':f.attachmentUrl||'','Remarks':f.remarks||'','Entered By':u.email,'Entered At':now});audit_('CASH FLOW OBLIGATION',id,'',f.status||'Planned',amt,f.head,u);return{ok:true,id}})}
function cashFlowV41_(f){f=f||{};const u=user_(),to=f.to?new Date(f.to+'T23:59:59'):new Date();let from=f.from?new Date(f.from+'T00:00:00'):new Date(to.getFullYear(),to.getMonth(),1);if((to.getFullYear()-from.getFullYear())*12+to.getMonth()-from.getMonth()>35)from=new Date(to.getFullYear(),to.getMonth()-35,1);const obs=objs_('Cash Flow Obligations').filter(x=>{const d=new Date(String(x.Month||'')+'-01T00:00:00');return d>=new Date(from.getFullYear(),from.getMonth(),1)&&d<=to&&(!f.company||f.company==='ALL'||x.Company===f.company)}),fixed=objs_('Fixed Commitments').filter(x=>String(x['Active?']||'Yes')==='Yes'&&(!f.company||f.company==='ALL'||x.Company===f.company)),months=[];let d=new Date(from.getFullYear(),from.getMonth(),1),end=new Date(to.getFullYear(),to.getMonth(),1);while(d<=end&&months.length<36){months.push(Utilities.formatDate(d,TZ,'yyyy-MM'));d.setMonth(d.getMonth()+1)}const om={};obs.forEach(x=>{const k=String(x.Month),r=om[k]||(om[k]={planned:0,paid:0,due:0});r.planned+=num_(x['Planned Amount']);if(String(x.Status)==='Paid')r.paid+=num_(x['Planned Amount']);else r.due++});const fixedMonthly=fixed.reduce((s,x)=>s+num_(x['Monthly Estimate']),0),monthly=months.map(k=>{const r=om[k],planned=r?r.planned:fixedMonthly,paid=r?r.paid:0;return[k,planned,paid,planned-paid]}),tot=monthly.reduce((a,x)=>({planned:a.planned+x[1],paid:a.paid+x[2],gap:a.gap+x[3]}),{planned:0,paid:0,gap:0});return{planned:tot.planned,paid:tot.paid,gap:tot.gap,due:obs.filter(x=>String(x.Status)!=='Paid').length,monthly,obligations:u.canReview?obs.slice(-500).reverse():[]}}
