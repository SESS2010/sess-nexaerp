function saveTravelV41_(f){return locked_(()=>{const u=user_(),e=employeeFor_(f.employeeId,u),points=typeof f.routePoints==='string'?JSON.parse(f.routePoints):f.routePoints,route=routeV41_(points),start=Number(f.startOdo),end=Number(f.endOdo),odo=Math.round((end-start)*10)/10,claimed=Number(f.claimedKm);if(!(end>=start))throw Error('End odometer must be equal to or above start odometer');if(!(claimed>=0))throw Error('Employee claimed KM is required');const diff=Math.round((claimed-route.googleKm)*10)/10,pct=route.googleKm?diff/route.googleKm:0,reason=String(f.excessReason||'').trim(),odoMismatch=Math.abs(claimed-odo)>1;if((Math.abs(pct)>V41.TOLERANCE||odoMismatch)&&reason.length<15)throw Error('A detailed reason of at least 15 characters is required for KM deviation or odometer mismatch');const status=Math.abs(pct)<=V41.TOLERANCE&&!odoMismatch?'WITHIN ±10%':'EXCEPTION - REVIEW REQUIRED',cfg=cfg_(),rate=num_(cfg['Default KM Rate']||3),amount=Math.round(claimed*rate*100)/100,now=new Date(),id=Utilities.formatDate(now,TZ,'yyyyMMdd-HHmmss')+'-TRV-'+Utilities.getUuid().slice(0,8),obj={'Claim ID':id,'Date':new Date(f.date),'Employee ID':e.id,'Employee Name':e.name,'Vehicle No.':f.vehicle||'','Start Odometer':start,'Start Location':route.points[0].address,'Stop 1':route.points[1]&&route.points.length>2?route.points[1].address:'','Stop 2':route.points[2]&&route.points.length>3?route.points[2].address:'','Stop 3':route.points[3]&&route.points.length>4?route.points[3].address:'','Stop 4':route.points[4]&&route.points.length>5?route.points[4].address:'','End Location':route.points[route.points.length-1].address,'End Odometer':end,'Google KM':route.googleKm,'Actual KM':claimed,'Variance KM':diff,'Variance %':pct,'Rate / KM':rate,'Claimed ₹':amount,'Alert':status,'Status':'Submitted','Accounts Verified Amount':'','Verified By':'','Verified At':'','Final Expense ₹':0,'Purpose / Remarks':f.purpose||'','Receipt URL':f.receiptUrl||'','Google Map Route':route.mapUrl,'Entered At':now,'Route Points JSON':JSON.stringify(route.points),'Route Segments JSON':JSON.stringify(route.legs),'Employee Claimed KM':claimed,'Odometer KM':odo,'Deviation % V41':pct,'Deviation Status V41':status,'Excess KM Reason':reason,'Accounts Recommended KM':'','Accounts Recommended Amount':'','MD Approved KM':'','MD Approved Amount':'','MD Decision Remarks':''};appendObject_(sheet_(S.TRIP),obj);audit_('TRAVEL CLAIM',id,'','Submitted',amount,status+(reason?' | '+reason:''),u);return{ok:true,id,googleKm:route.googleKm,claimedKm:claimed,odometerKm:odo,variancePct:pct,alert:status,claim:amount,legs:route.legs}})}
function pendingAllV41_(){const rows=pendingAll(),trip=Object.fromEntries(objs_(S.TRIP).map(x=>[String(x['Claim ID']),x])),exp=Object.fromEntries(objs_(S.EXP).map(x=>[String(x['Expense ID']),x]));return rows.map(x=>{if(x.kind!=='TRAVEL'){const e=exp[String(x.id)]||{};return Object.assign(x,{expenseType:e['Expense Type']||'',policyStatus:e['Policy Status']||'',policyReason:e['Policy Exception Reason']||'',attachments:String(e['Attachment URLs']||e['Receipt URL']||'').split(/\n+/).filter(Boolean),gstBill:e['GST Bill Available?']||'',people:e['People Count']||''})}const t=trip[String(x.id)]||{};return Object.assign(x,{googleKm:num_(t['Google KM']),claimedKm:num_(t['Employee Claimed KM']||t['Actual KM']),odometerKm:num_(t['Odometer KM']),deviationPct:num_(t['Deviation % V41']||t['Variance %']),deviationStatus:t['Deviation Status V41']||t.Alert||'',excessReason:t['Excess KM Reason']||'',segments:(()=>{try{return JSON.parse(t['Route Segments JSON']||'[]')}catch(e){return[]}})(),accountsKm:num_(t['Accounts Recommended KM']),mdKm:num_(t['MD Approved KM']),rate:num_(t['Rate / KM'])})})}
function reviewTravelV41_(id,action,km,remarks){return locked_(()=>{const u=user_(),sh=sheet_(S.TRIP),{m}=headerMap_(sh),ids=sh.getRange(2,m['Claim ID']+1,Math.max(1,sh.getLastRow()-1),1).getDisplayValues().flat(),ix=ids.indexOf(String(id));if(ix<0)throw Error('Travel claim not found');const row=ix+2,t=rowObject_(sh,row),old=String(t.Status||''),google=num_(t['Google KM']),claimed=num_(t['Employee Claimed KM']||t['Actual KM']),rate=num_(t['Rate / KM']),note=String(remarks||'').trim();let next='',finalKm=0,amount=0;if(action==='VERIFY'){requireAccountsAction_();if(!['Submitted','Pending','Need Clarification'].includes(old))throw Error('Only submitted claims can be verified');finalKm=Number(km);if(!(finalKm>=0&&finalKm<=claimed))throw Error('Accounts recommended KM must be between 0 and employee claimed KM');if(Math.abs(finalKm-google)/Math.max(google,1)>.10&&note.length<10)throw Error('Accounts remarks are required for recommendation above ±10%');amount=Math.round(finalKm*rate*100)/100;next='Accounts Verified';setFields_(sh,row,{'Status':next,'Accounts Verified Amount':amount,'Verified By':u.email,'Verified At':new Date(),'Accounts Recommended KM':finalKm,'Accounts Recommended Amount':amount})}else if(action==='APPROVE'){if(!['MD','ADMIN'].includes(u.role))throw Error('Only MD can final approve');if(old!=='Accounts Verified')throw Error('Accounts verification required before MD approval');finalKm=Number(km);if(!(finalKm>=0&&finalKm<=claimed))throw Error('MD approved KM must be between 0 and employee claimed KM');if(Math.abs(finalKm-google)/Math.max(google,1)>.10&&note.length<10)throw Error('MD remarks are required when approving above ±10%');amount=Math.round(finalKm*rate*100)/100;next='Approved';setFields_(sh,row,{'Status':next,'Final Expense ₹':amount,'MD Approved KM':finalKm,'MD Approved Amount':amount,'MD Decision Remarks':note})}else if(action==='CLARIFY'||action==='REJECT'){const mdStage=old==='Accounts Verified';if(mdStage){if(!['MD','ADMIN'].includes(u.role))