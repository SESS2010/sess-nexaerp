function reportV41_(f){const out=reportV3(f),u=user_();f=f||{};if(!u.canReview)f.employeeId=u.employeeId;const from=f.from?new Date(f.from+'T00:00:00'):new Date(2000,0,1),to=f.to?new Date(f.to+'T23:59:59'):new Date(2100,0,1),ok=x=>{const d=new Date(x.Date);return d>=from&&d<=to&&(!f.employeeId||f.employeeId==='ALL'||String(x['Employee ID'])===String(f.employeeId))},tr=objs_(S.TRIP).filter(ok),ex=objs_(S.EXP).filter(ok);let googleKm=0,claimedKm=0,approvedKm=0,exceptions=0,savedKm=0,pettyCash=0,policyExceptions=0,unsupported=0;tr.forEach(x=>{const g=num_(x['Google KM']),c=num_(x['Employee Claimed KM']||x['Actual KM']),a=num_(x['MD Approved KM']);googleKm+=g;claimedKm+=c;approvedKm+=a;exceptions+=String(x['Deviation Status V41']||'').includes('EXCEPTION')?1:0;if(a>0)savedKm+=Math.max(0,c-a)});ex.forEach(x=>{if(String(x['Expense Type'])==='Petty Cash Purchase')pettyCash+=num_(x['Claimed Amount']);if(String(x['Policy Status']).includes('EXCEPTION'))policyExceptions++;if(['Food','Lodging - Single','Lodging - Double','Bus / Train Travel','Petty Cash Purchase'].includes(String(x['Expense Type']))&&!String(x['Attachment URLs']||x['Receipt URL']).trim())unsupported++});out.km={googleKm,claimedKm,approvedKm,exceptions,savedKm};out.policy={pettyCash,exceptions:policyExceptions,unsupported};out.cashflow=cashFlowV41_(f);const pm=Object.fromEntries(out.cashflow.monthly.map(x=>[x[0],x[1]]));out.monthly=out.monthly.map(x=>[x[0],x[1],x[2],pm[x[0]]||0]);return out}
