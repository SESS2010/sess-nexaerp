function placeSuggestionsV41_(q){q=String(q||'').trim();if(q.length<3)return[];const body={input:q,includedRegionCodes:['in'],languageCode:'en',regionCode:'IN'},out=fetchJson_('https://places.googleapis.com/v1/places:autocomplete',{method:'post',contentType:'application/json',headers:{'X-Goog-Api-Key':mapsKey_(),'X-Goog-FieldMask':'suggestions.placePrediction.placeId,suggestions.placePrediction.text,suggestions.placePrediction.structuredFormat'},payload:JSON.stringify(body)});return(out.suggestions||[]).map(x=>x.placePrediction).filter(Boolean).slice(0,7).map(x=>({placeId:x.placeId,text:x.text&&x.text.text||'',main:x.structuredFormat&&x.structuredFormat.mainText&&x.structuredFormat.mainText.text||'',secondary:x.structuredFormat&&x.structuredFormat.secondaryText&&x.structuredFormat.secondaryText.text||''}))}
