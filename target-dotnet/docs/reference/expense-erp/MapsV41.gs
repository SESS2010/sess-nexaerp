function setupGoogleMapsApiKeyV41(){const ui=SpreadsheetApp.getUi(),r=ui.prompt('SESS V4.1 - Google Maps API Key','Paste the restricted API key with Places API (New) and Routes API enabled.',ui.ButtonSet.OK_CANCEL);if(r.getSelectedButton()!==ui.Button.OK)return'Cancelled';const key=String(r.getResponseText()||'').trim();if(key.length<20)throw Error('API key is invalid or empty');PropertiesService.getScriptProperties().setProperty(V41.KEY,key);return'Google Maps API key saved securely in Script Properties.'}
