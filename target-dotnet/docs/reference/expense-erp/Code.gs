function backupUrl(){require_(ROLES.ACCOUNTS);return'https://docs.google.com/spreadsheets/d/'+ss_().getId()+'/export?format=xlsx'}
function cfg_(){return Object.fromEntries(objs_(S.CFG).map(x=>[x.Setting,x.Value]))}
