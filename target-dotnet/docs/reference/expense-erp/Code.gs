const S={EMP:'Employee Master',EXP:'Expense Register',TRIP:'Travel Claims',ADV:'Employee Advances',SET:'Returns & Payments',CFG:'Config',ROLE:'Role Master',AUDIT:'Approval Audit',LOC:'Location Master',LOGIN:'Login Audit'};
