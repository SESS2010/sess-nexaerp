function suggestLocations(q){q=String(q||'').trim();if(q.length<3)return[];const r=Maps.newGeocoder().setRegion('in').geocode(q),out=[];((r&&r.results)||[]).slice(0,7).forEach(x=>{if(x.formatted_address&&!out.includes(x.formatted_address))out.push(x.formatted_address)});return out}
function saveTrip(f){return locked_(()=>{const u=user_(),e=employeeFor_(f.employeeId,u),actual=Number(f.endOdo)-Number(f.startOdo);if(!(actual>=0))throw Error('End odometer must be equal to or above start odometer');const stops=[f.stop1,f.stop2,f.stop3,f.stop4],g=distance_(f.start,stops,f.end),variance=Math.round((actual-g)*10)/10,vp=g?variance/g:0,alert=Math.abs(vp)<=.10?'OK':Math.abs(vp)<=.20?'REVIEW':'HIGH',rate=bootstrap().kmRate||3,claim=Math.round(actual*rate*100)/100,now=new Date(),id=Utilities.formatDate(now,TZ,'yyyyMMdd-HHmmss')+'-TRV-'+Utilities.getUuid().slice(0,8);write_(S.TRIP,[id,new Date(f.date),e.id,e.name,f.vehicle||'',Number(f.startOdo),f.start||'',f.stop1||'',f.stop2||'',f.stop3||'',f.stop4||'',f.end||'',Number(f.endOdo),g,actual,variance,vp,rate,claim,alert,'Submitted','','','',0,f.purpose||'',f.receiptUrl||'',routeUrl_(f.start,stops,f.end),now]);audit_('TRAVEL CLAIM',id,'','Submitted',claim,'Employee submission',u);return{ok:true,id,googleKm:g,actualKm:actual,variancePct:vp,alert,claim}})}
function saveAdvance(f){return locked_(()=>{const u=requireAccountsAction_(),e=employeeFor_(f.employeeId,u),amt=Number(f.amount);if(!(amt>0))throw Error('Amount must be above zero');const now=new Date(),id=Utilities.formatDate(now,TZ,'yyyyMMdd-HHmmss')+'-ADV-'+Utilities.getUuid().slice(0,8);write_(S.ADV,[id,new Date(f.date),f.company,e.id,e.name,amt,f.mode||'Cash',f.reference||'',f.purpose||'',f.costCentre||'',f.project||'',u.email,now]);audit_('ADVANCE',id,'','Issued',amt,f.purpose,u);return{ok:true,id}})}
