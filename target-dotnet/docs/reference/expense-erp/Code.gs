function reviewExpense(id,action,accepted,remarks){return locked_(()=>{const u=user_(),sh=sheet_(S.EXP),v=sh.getDataRange().getValues(),idx=v[0].indexOf('Expense ID');for(let r=1;r<v.length;r++)if(String(v[r][idx])===String(id)){const old=String(v[r][11]||''),claim=num_(v[r][9]),note=String(remarks||'').trim();let next='',a=0;if(action==='VERIFY'){requireAccountsAction_();if(!['Submitted','Pending','Need Clarification'].includes(old))throw Error('Only submitted claims can be verified');const n=accepted===''?claim:Number(accepted);if(!Number.isFinite(n)||n<0||n>claim)throw Error('Accounts amount must be between 0 and claimed amount');next='Accounts Verified';a=n}else if(action==='APPROVE'){if(!['MD','ADMIN'].includes(u.role))throw Error('Only MD can final approve');if(old!=='Accounts Verified')throw Error('Accounts verification required before MD approval');const n=accepted===''?(num_(v[r][12])||claim):Number(accepted);if(!Number.isFinite(n)||n<0||n>claim)throw Error('MD amount must be between 0 and claimed amount');next='Approved';a=n}else if(action==='CLARIFY'||action==='REJECT'){const mdStage=old==='Accounts Verified';if(mdStage){if(!['MD','ADMIN'].includes(u.role))throw Error('Only MD can act at final approval stage')}else requireAccountsAction_();if(note.length<5)throw Error('Remarks are required');next=action==='CLARIFY'?'Need Clarification':'Rejected'}else throw Error('Invalid action');sh.getRange(r+1,12,1,3).setValues([[next,a,next==='Approved'?claim-a:next==='Rejected'?claim:0]]);sh.getRange(r+1,22,1,3).setValues([[u.email,new Date(),v[r][23]||u.email]]);audit_('GENERAL EXPENSE',id,old,next,a,note,u);return{ok:true,status:next,accepted:a}}throw Error('Expense not found')})}
