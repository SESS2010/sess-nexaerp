function pendingExpensesV3(){const u=require_(ROLES.ACCOUNTS),allowed=u.canApprove?['Accounts Verified','Submitted','Pending','Need Clarification']:['Submitted','Pending','Need Clarification'];return objs_(S.EXP).filter(x=>allowed.includes(String(x.Status))).slice(-300).reverse().map(x=>({id:x['Expense ID'],date:date_(x.Date),employee:x['Employee Name'],company:x.Company,category:x.Category,description:x.Description,claimed:num_(x['Claimed Amount']),accepted:num_(x['Accepted Amount']),receipt:x['Receipt URL']||'',status:x.Status}))}
