function write_(sheet,row){const sh=sheet_(sheet),last=Math.max(sh.getLastRow(),2),ids=sh.getRange(2,1,last-1,1).getDisplayValues(),i=ids.findIndex(r=>!String(r[0]).trim()),target=i<0?last+1:i+2;sh.getRange(target,1,1,row.length).setValues([row]);return target}
function locked_(fn){const l=LockService.getDocumentLock();l.waitLock(30000);try{return fn()}finally{l.releaseLock()}}
function audit_(type,id,oldStatus,newStatus,amount,remarks,u){write_(S.AUDIT,[Utilities.getUuid(),type,id,oldStatus,newStatus,Number(amount)||0,remarks||'',u.email,new Date()])}
function saveExpense(f){return locked_(()=>{const u=user_(),e=employeeFor_(f.employeeId,u),amt=Number(f.amount);if(!(amt>0))throw Error('Amount must be above zero');const b=bootstrap();if(amt>=b.receiptThreshold&&!f.receiptUrl)throw Error('Receipt URL is required for this amount');const now=new Date(),id=Utilities.formatDate(now,TZ,'yyyyMMdd-HHmmss')+'-EXP-'+Utilities.getUuid().slice(0,8);write_(S.EXP,[id,new Date(f.date),f.company,e.id,e.name,f.category,f.subcategory||'',f.vendor||'',f.description||'',amt,f.mode||'Cash','Submitted','',0,f.gstIncluded||'No',Number(f.gstAmount)||0,f.costCentre||'',f.project||'',f.invoiceNo||'',f.invoiceDate?new Date(f.invoiceDate):'',f.receiptUrl||'','','',u.email,now]);audit_('GENERAL EXPENSE',id,'','Submitted',amt,'Employee submission',u);return{ok:true,id}})}
function distance_(a,stops,z){if(!a||!z)throw Error('Start and end locations are required');let d=Maps.newDirectionFinder().setOrigin(a).setDestination(z).setMode(Maps.DirectionFinder.Mode.DRIVING);stops.filter(Boolean).forEach(x=>d.addWaypoint(x));const out=d.getDirections(),route=out.routes&&out.routes[0];if(!route)throw Error('Google Maps route not found');let m=0;route.legs.forEach(l=>m+=l.distance.value);return Math.round(m/100)/10}
