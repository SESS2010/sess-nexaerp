{
  "realm": "staff",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 28800,
  "browserFlow": "browser",
  "authenticationFlows": [],
  "clients": [
    {
      "clientId": "nexaerp-staff",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://192.168.68.130:8443/oidc/callback"
      ],
      "webOrigins": [
        "https://192.168.68.130:8443"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://192.168.68.130:8443/oidc/logout-callback"
      },
      "defaultClientScopes": [
        "nexaerp/access"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "erp-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "nexaerp",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "stable-subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ],
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false
    }
  ],
  "clientScopes": [
    {
      "name": "nexaerp/access",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "passwordPolicy": "length(14)",
  "bruteForceProtected": true,
  "clientSessionMaxLifespan": 28800,
  "clientSessionIdleTimeout": 28800,
  "requiredActions": [
    {
      "name": "Configure OTP",
      "config": {},
      "alias": "CONFIGURE_TOTP",
      "providerId": "CONFIGURE_TOTP",
      "defaultAction": false,
      "priority": 10,
      "enabled": true
    }
  ],
  "displayName": "Staff",
  "users": [],
  "identityProviders": []
}
